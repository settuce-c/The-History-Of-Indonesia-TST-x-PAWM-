# Salin ke .env lalu isi nilainya:  cp .env.example .env
# JANGAN commit file .env (sudah ada di .gitignore).
# Buat nilai acak dengan:  openssl rand -hex 32

# ---- core-service ----
NODE_ENV=production
PORT=3000
DB_PATH=/data/app.db
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*
SEED_ON_START=true

# ---- akun uji (dibuat otomatis saat start jika belum ada) ----
SEED_ADMIN_EMAIL=admin@thehistoryofid.test
SEED_ADMIN_PASSWORD=ganti-password-admin
SEED_STUDENT_EMAIL=siswa@thehistoryofid.test
SEED_STUDENT_PASSWORD=ganti-password-siswa

# ---- API key kelompok mitra (header X-API-Key) ----
API_KEY_CLASSROOM_SERVICE=ganti-key-classroom-service
API_KEY_TOURISM_LANGUAGE=ganti-key-tourism-language

# ---- Generator kuis AI (Gemini) — hanya dipakai endpoint admin ----
# Model AI TIDAK berjalan di STB; backend hanya memanggil API-nya. Ambil key di https://aistudio.google.com/apikey
# Kosongkan bila belum punya: fitur kuis lain tetap jalan, generator membalas 503 AI_NOT_CONFIGURED.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=25000

# ---- Wikipedia (materi "Baca lebih lanjut") ----
# User-Agent wajib jelas menurut kebijakan Wikimedia; tambahkan cara menghubungi kelompok bila perlu.
WIKI_USER_AGENT=TheHistoryOfIndonesia/1.0 (https://thehistoryofid.stei.site; aplikasi edukasi sejarah)
WIKI_CACHE_DAYS=7

# ---- Cloudflare Tunnel ----
TUNNEL_TOKEN=isi-token-dari-dashboard-cloudflare
